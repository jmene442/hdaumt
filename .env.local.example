# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas (or any Mongo) connection string, including the database name.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/music-composer

# Random secret for Auth.js session encryption — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (add your prod URL too)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key for the chord/structure suggestion feature.
ANTHROPIC_API_KEY=

# Invite-only access: comma-separated list of Google account emails allowed
# to sign in. Anyone else is rejected at sign-in (see auth.ts).
ALLOWED_EMAILS=you@example.com,teammate@example.com
