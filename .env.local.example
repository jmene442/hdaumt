# Copy to .env.local and fill in real values. Never commit .env.local.

# MongoDB Atlas (or any Mongo) connection string, including the database name.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/music-composer

# Random secret for Auth.js session encryption — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (add your prod URL too)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Anthropic API key for the chord/structure suggestion feature.
ANTHROPIC_API_KEY=

# Invite-only access: comma-separated list of Google account emails allowed
# to sign in. Anyone else is rejected at sign-in (see auth.ts).
ALLOWED_EMAILS=you@example.com,teammate@example.com

# Datadog Logs API key for batched log forwarding (lib/datadog.ts) — the
# app's primary observability tool instead of Vercel's own log viewer.
# Create one at https://app.datadoghq.com/organization-settings/api-keys
DATADOG_API_KEY=
# Datadog site/region. Defaults to datadoghq.com (US1) if unset.
DATADOG_SITE=datadoghq.com
DATADOG_APP_KEY=
NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=

# Datadog RUM (Real User Monitoring) — loaded via CDN script in app/layout.tsx.
# Create an application at https://app.datadoghq.com/rum/application/create
NEXT_PUBLIC_DD_RUM_APPLICATION_ID=
NEXT_PUBLIC_DD_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_DD_SITE=datadoghq.com
NEXT_PUBLIC_DD_ENV=development
NEXT_PUBLIC_DD_SERVICE=hdaumt
# Tags RUM sessions with the app's release version. Bump this to match the
# version tag every time a new release is cut (see progress/ + git tags).
NEXT_PUBLIC_DD_VERSION=0.1.0